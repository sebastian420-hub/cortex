# Settings for run-task.sh when run by systemd (copy to ~/.config/cortex/nightly.env).
# No quotes needed; systemd reads each line as NAME=value.

CORTEX_REPO=/home/me/projects/myrepo
CORTEX_TASK_FILE=/home/me/.config/cortex/tasks/fix-failing-tests.md

# Use an absolute path to the interpreter: a virtualenv kept inside the repository is not part of
# the branch, so it does not exist in the task's worktree. `python -m pytest` makes Python import
# the code in the worktree.
CORTEX_VERIFY=/home/me/projects/myrepo/.venv/bin/python -m pytest -q

# A local OpenAI-compatible server (vLLM, llama.cpp, LM Studio). No key is needed.
OPENAI_BASE_URL=http://localhost:8000/v1
# What the server was started with (vLLM: --max-model-len). Cortex sizes its history to it.
CORTEX_OPENAI_CONTEXT_WINDOW=65536

# 0: leave the branch for you to review. 1: push it to "origin", but only if it verified.
CORTEX_PUSH=0
CORTEX_WALL_TIMEOUT=5400
