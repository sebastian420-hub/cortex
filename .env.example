# Cortex Environment Variables Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# API KEYS - Required for respective providers
# ============================================================================

# OpenRouter API Key (for accessing multiple models including Kimi, MiMo, etc.)
# Get your key from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter optional headers (for rankings/tracking)
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_X_TITLE=Cortex CLI

# DeepSeek API Key (for DeepSeek models)
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Anthropic API Key (for Claude models)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# CORTEX CONFIGURATION - Optional settings
# ============================================================================

# Default model to use
# CORTEX_MODEL=llama3.2

# Permission mode: auto, normal, strict
# CORTEX_MODE=normal

# Provider: ollama, anthropic, deepseek, openrouter
# CORTEX_PROVIDER=ollama

# Maximum iterations per session
# CORTEX_MAX_ITERATIONS=15

# Continue iterations by default when max is reached
# CORTEX_MAX_ITERATIONS_CONTINUE_DEFAULT=false

# Amount to continue when continuing iterations
# CORTEX_MAX_ITERATIONS_CONTINUE_AMOUNT=10

# Maximum tokens for conversation context
# CORTEX_MAX_TOKENS=100000

# Output format: text, json, minimal
# CORTEX_OUTPUT_FORMAT=text

# Enable/disable hooks
# CORTEX_HOOKS_ENABLED=true

# ============================================================================
# TIMEOUT CONFIGURATION - Optional
# ============================================================================

# Default timeout for tool execution (seconds)
# CORTEX_TIMEOUT_DEFAULT=30

# Timeout for git operations (seconds)
# CORTEX_TIMEOUT_GIT=10

# Timeout for test execution (seconds)
# CORTEX_TIMEOUT_TEST=120

# Timeout for search operations (seconds)
# CORTEX_TIMEOUT_SEARCH=60

# ============================================================================
# SESSION MANAGEMENT - Optional
# ============================================================================

# Maximum age of sessions in days
# CORTEX_SESSION_MAX_AGE_DAYS=30

# Maximum number of sessions to keep
# CORTEX_SESSION_MAX_COUNT=100

# Cleanup sessions on startup
# CORTEX_SESSION_CLEANUP_ON_STARTUP=false

# ============================================================================
# ERROR RECOVERY - Optional
# ============================================================================

# Enable smart error recovery
# CORTEX_RECOVERY_ENABLED=false
