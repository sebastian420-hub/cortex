# What counts toward coverage.
#
# Everything under cortex/ counts except three optional components that cannot run in a normal
# test environment: the compiled Rust bindings, the Go service client, and the Redis backend
# (which needs a Redis server). Nothing else is omitted: memory, planning, permissions, the agent
# loop, providers, tools and the CLI are all measured, so the number below is the real one.
[run]
source = cortex
omit =
    */tests/*
    */__pycache__/*
    setup.py
    */native/*
    */services/*
    */redis_backend.py

[report]
omit =
    */tests/*
    */__pycache__/*
    setup.py
    */native/*
    */services/*
    */redis_backend.py
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    @abc.abstractmethod

# Set a few points below the figure measured when the omissions were removed, so a regression
# fails CI. Raise it as coverage grows; never lower it by omitting code. (CI prints the current
# figure on every run; it is not repeated here so it cannot go stale.)
fail_under = 64
